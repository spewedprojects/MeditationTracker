<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme_Auto" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary (CTA buttons, accents) -->
        <item name="colorPrimary">@color/black_white</item>
        <item name="colorOnPrimary">@color/white_black</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/window_background</item>
        <item name="colorSurfaceContainer">@color/primaryVariant</item>
        <item name="colorSurfaceContainerHigh">@color/primary</item>
        <item name="colorSurfaceContainerHighest">@color/primary</item>

        <!-- Content on surfaces -->
        <item name="colorOnSurface">@color/black_white</item>
        <item name="colorOnSurfaceVariant">@color/onPrimary2</item>
        <item name="colorOutlineVariant">@color/black_white_0.1</item>

        <!-- Legacy (kept for compatibility) -->
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorAccent">@color/onPrimary2</item>
        <item name="colorButtonNormal">@color/switchbutton</item>
        <item name="colorBackgroundFloating">@color/deletebutton</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorSurfaceDim">@color/dialog_bg</item>
        <item name="android:textColorHint">@color/textHintcolor</item>
        <item name="colorOnPrimarySurface">@color/barChart</item>

        <item name="android:textColorHighlight">@color/text_highlight_color</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondaryVariant</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Customize your theme here. -->
        <item name="colorPrimaryInverse">@color/white</item>
    </style>
</resources>