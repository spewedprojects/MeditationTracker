<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReleaseNotesActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">
    </com.google.android.material.appbar.MaterialToolbar> <!-- Constrained layout for menubutton and Title -->
    <include
        layout="@layout/actiontoolbar"/>

    <LinearLayout
        android:id="@+id/card_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar2"
        app:layout_constraintVertical_bias="0">

        <androidx.cardview.widget.CardView
            android:id="@+id/lastest_release"
            android:layout_width="match_parent"
            android:layout_weight="1.4"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="?attr/colorPrimaryVariant"
            app:cardCornerRadius="?attr/customCardRadius"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/release_notes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:filterTouchesWhenObscured="false"
                    android:focusableInTouchMode="true"
                    android:textAppearance="?attr/textAppearanceAppTitle"
                    tools:theme="@style/TextAppearance.MeditationTracker.AppFont.AppTitle"
                    android:text="Release Notes"
                    android:textColor="?attr/colorOnPrimary"
                    tools:ignore="TextViewEdits" /> <!-- Release notes page title -->

                <TextView
                    android:id="@+id/current_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:letterSpacing="0"
                    android:filterTouchesWhenObscured="false"
                    android:focusableInTouchMode="true"
                    android:textAppearance="?attr/textAppearanceAppButton"
                    tools:theme="@style/TextAppearance.MeditationTracker.AppFont.AppButton"
                    android:text="@string/app_version"
                    android:textColor="?attr/colorOnPrimary"
                    tools:ignore="TextViewEdits" /> <!-- current version display -->

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:requiresFadingEdge="vertical"
                    android:layout_marginVertical="8dp">

                    <TextView
                            android:id="@+id/current_version_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp"
                            android:filterTouchesWhenObscured="false"
                            android:focusableInTouchMode="true"
                            android:textAppearance="?attr/textAppearanceAppSubtitle2"
                            tools:theme="@style/TextAppearance.MeditationTracker.AppFont.Subtitle2"
                            android:letterSpacing="0.02"
                            android:text="@string/current_version_details"
                            android:textColor="?attr/colorOnPrimary"
                            tools:ignore="TextViewEdits" /> <!-- Release notes page title -->

                </androidx.core.widget.NestedScrollView>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RN_recyclerview"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="0dp"
            android:requiresFadingEdge="vertical"
            android:layout_marginBottom="8dp"
            android:clipToPadding="true"
            android:orientation="vertical"
            android:scrollbars="vertical"
            android:contentDescription="@string/v1.16.c">
        </androidx.recyclerview.widget.RecyclerView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>